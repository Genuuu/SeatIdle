rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for other routes
    match /{document=**} {
      allow read, write: if false;
    }

    // Library Status: Anyone can read & write (supports hardware simulator updates)
    match /library_status/{docId} {
      allow read, write: if true;
    }

    // Staff Presence: Anyone can read & write
    match /staff_presence/{staffId} {
      allow read, write: if true;
    }

    // Staff Logs: Anyone can read & write
    match /staff_presence/{staffId}/logs/{logId} {
      allow read, write: if true;
    }

    // Staff Portal Logins: Anyone can read & write
    match /staff_presence/{staffId}/portal_logins/{loginId} {
      allow read, write: if true;
    }

    // Active Reservations: Anyone can read & write
    match /active_reservations/{reservationId} {
      allow read, write: if true;
    }

    // Scheduled Reservations: Anyone can read & write
    match /scheduled_reservations/{reservationId} {
      allow read, write: if true;
    }

    // Announcements: Anyone can read & write
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Occupancy History: Anyone can read & write
    match /occupancy_history/{historyId} {
      allow read, write: if true;
    }

    // Reported Issues: Anyone can read & write
    match /reported_issues/{issueId} {
      allow read, write: if true;
    }
  }
}
